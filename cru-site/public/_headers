# Read by Netlify and Cloudflare Pages. GitHub Pages ignores this file --
# it cannot set response headers at all, which is one more reason to prefer
# Netlify or Cloudflare for production.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
