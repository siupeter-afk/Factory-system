---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/ui.ts';
import { NAV } from '../i18n/nav.ts';
import LocaleSwitcher from './LocaleSwitcher.astro';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
const home = getRelativeLocaleUrl(locale, '');
---
<header class="sticky top-0 z-40 border-b border-line bg-ground/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={home} class="group flex shrink-0 items-baseline gap-2">
      <!-- Wordmark stands in for the logo until brand/cru-media-logo.svg is supplied. -->
      <span class="font-display text-xl font-semibold tracking-tight text-paper transition-colors group-hover:text-brass">
        Cru&thinsp;Media
      </span>
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label={t('nav.menu')}>
      {
        NAV.map((item) => {
          const href = getRelativeLocaleUrl(locale, item.path);
          const isActive = item.path === path;
          return (
            <a
              href={href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'text-sm transition-colors',
                isActive ? 'text-brass' : 'text-paper-dim hover:text-paper',
              ]}
            >
              {t(item.labelKey)}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-3">
      <LocaleSwitcher locale={locale} path={path} />
      <button
        type="button"
        id="nav-toggle"
        class="lg:hidden rounded p-2 text-paper-dim hover:text-paper"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label={t('nav.menu')}
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    hidden
    class="border-t border-line bg-ground-raised px-4 py-3 lg:hidden"
    aria-label={t('nav.menu')}
  >
    <ul class="flex flex-col gap-1">
      {
        NAV.map((item) => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, item.path)}
              aria-current={item.path === path ? 'page' : undefined}
              class:list={[
                'block rounded px-3 py-2.5 text-sm transition-colors',
                item.path === path ? 'bg-line text-brass' : 'text-paper-dim hover:bg-line hover:text-paper',
              ]}
            >
              {t(item.labelKey)}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  // Progressive enhancement: the mobile panel starts in the `hidden` state and
  // is only reachable once this runs, so no JS means the desktop nav links in
  // the footer remain the navigation path.
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  if (toggle && panel) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  }
</script>
