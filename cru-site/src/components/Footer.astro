---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/ui.ts';
import { NAV } from '../i18n/nav.ts';
import { SITE } from '../config/site.ts';
import LocaleSwitcher from './LocaleSwitcher.astro';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const socials = Object.entries(SITE.social).filter(([, url]) => url);
---
<footer class="border-t border-line bg-ground-sunk">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <p class="font-display text-lg font-semibold text-paper">Cru&thinsp;Media</p>
        <p class="mt-1 text-sm text-muted">{t('site.tagline')}</p>
        <div class="mt-5"><LocaleSwitcher locale={locale} path={path} /></div>
      </div>

      <nav aria-label={t('nav.menu')}>
        <ul class="grid grid-cols-2 gap-x-10 gap-y-2 sm:grid-cols-3">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={getRelativeLocaleUrl(locale, item.path)}
                  class="text-sm text-paper-dim transition-colors hover:text-brass"
                >
                  {t(item.labelKey)}
                </a>
              </li>
            ))
          }
        </ul>
        {
          socials.length > 0 && (
            <ul class="mt-6 flex gap-4">
              {socials.map(([name, url]) => (
                <li>
                  <a href={url} rel="noopener noreferrer me" target="_blank" class="text-sm text-muted hover:text-brass">
                    {name}
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </nav>
    </div>

    <div class="mt-12 border-t border-line pt-6">
      <!-- Responsible-drinking notice: expected of any alcohol-related site. -->
      <p class="text-sm font-medium text-brass">{t('footer.responsible')}</p>
      <!-- Trademark attribution. Driven by the per-brand `ownership` field, so
           it cannot drift out of step with the brand pages. -->
      <p class="mt-3 max-w-2xl text-xs leading-relaxed text-muted">{t('footer.licensingNote')}</p>
      <p class="mt-4 text-xs text-muted">
        &copy; {year} {SITE.legalName}. {t('footer.rights')}
      </p>
    </div>
  </div>
</footer>
