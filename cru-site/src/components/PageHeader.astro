---
interface Props {
  eyebrow?: string | undefined;
  title: string;
  intro?: string | undefined;
}
const { eyebrow, title, intro } = Astro.props;
---
<header class="mx-auto max-w-7xl px-4 pt-16 pb-10 sm:px-6 sm:pt-20">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1 class="mt-3 font-display text-4xl font-semibold text-paper sm:text-5xl">{title}</h1>
  {intro && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-paper-dim">{intro}</p>}
  <div class="rule mt-10"></div>
</header>
