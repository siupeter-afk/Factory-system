---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/ui.ts';
import BrandAttribution from './BrandAttribution.astro';

interface Props {
  locale: Locale;
  slug: string;
  title: string;
  kind: 'magazine' | 'event';
  tagline: string;
  ownership: 'own' | 'licensed';
  licensedTerritory?: string | undefined;
  logo?: string | undefined;
}

const { locale, slug, title, kind, tagline, ownership, licensedTerritory, logo } = Astro.props;
const t = useTranslations(locale);
const href = getRelativeLocaleUrl(locale, `brands/${slug}`);
---
<a
  href={href}
  class="group flex flex-col gap-4 rounded-xl border border-line bg-ground-raised p-6 transition-colors hover:border-brass-dim"
>
  <div class="flex items-start justify-between gap-3">
    <span class="eyebrow">{t(`brand.kind.${kind}`)}</span>
    <svg
      width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"
      class="shrink-0 text-muted transition-colors group-hover:text-brass"
    >
      <path d="M5 3l6 5-6 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </div>

  {logo && <img src={logo} alt="" width="120" height="40" class="h-10 w-auto object-contain object-left" />}

  <div>
    <h3 class="font-display text-xl font-semibold text-paper transition-colors group-hover:text-brass">
      {title}
    </h3>
    <p class="mt-1.5 text-sm leading-relaxed text-paper-dim">{tagline}</p>
  </div>

  <BrandAttribution
    locale={locale}
    ownership={ownership}
    licensedTerritory={licensedTerritory}
    class="mt-auto"
  />
</a>
