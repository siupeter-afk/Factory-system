---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/ui.ts';
import { formatDate } from '../lib/format.ts';

interface Props {
  locale: Locale;
  title: string;
  issueNumber: string;
  publishedAt: Date;
  blurb: string;
  cover?: string | undefined;
  coverAlt: string;
  readUrl?: string | undefined;
}

const { locale, title, issueNumber, publishedAt, blurb, cover, coverAlt, readUrl } = Astro.props;
const t = useTranslations(locale);
---
<article class="flex flex-col">
  <!-- 3:4 portrait, matching the cover ratio in the asset manifest. The tile
       stands in until a real cover is supplied, so layout is final either way. -->
  <div class="relative aspect-3/4 overflow-hidden rounded-lg border border-line bg-ground-raised">
    {
      cover ? (
        <img src={cover} alt={coverAlt} loading="lazy" class="h-full w-full object-cover" />
      ) : (
        <div class="flex h-full w-full flex-col items-center justify-center gap-2 p-4 text-center">
          <span class="font-display text-lg text-brass-dim">{issueNumber}</span>
          <span class="text-xs text-muted">{t('common.todo')}</span>
        </div>
      )
    }
  </div>

  <p class="mt-3 text-xs text-brass">{issueNumber}</p>
  <h3 class="mt-1 font-display text-base font-semibold text-paper">{title}</h3>
  <time datetime={publishedAt.toISOString().slice(0, 10)} class="mt-1 text-xs text-muted">
    {formatDate(publishedAt, locale)}
  </time>
  <p class="mt-2 text-sm leading-relaxed text-paper-dim">{blurb}</p>

  {
    readUrl && (
      <a
        href={readUrl}
        rel="noopener noreferrer"
        target="_blank"
        class="mt-3 text-sm font-medium text-brass hover:text-brass-bright"
      >
        {t('issues.read')}
      </a>
    )
  }
</article>
