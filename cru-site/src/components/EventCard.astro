---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/ui.ts';
import { formatDateRange } from '../lib/format.ts';

interface Props {
  locale: Locale;
  title: string;
  startDate: Date;
  endDate?: Date | undefined;
  venue: string;
  city: string;
  audience: 'trade' | 'consumer' | 'trade-and-consumer';
  summary: string;
  ticketUrl?: string | undefined;
  status: 'upcoming' | 'past';
}

const { locale, title, startDate, endDate, venue, city, audience, summary, ticketUrl, status } =
  Astro.props;
const t = useTranslations(locale);
---
<article
  class:list={[
    'rounded-xl border border-line bg-ground-raised p-6',
    status === 'past' && 'opacity-70',
  ]}
>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <time datetime={startDate.toISOString().slice(0, 10)} class="text-sm font-medium text-brass">
      {formatDateRange(startDate, endDate, locale)}
    </time>
    <span class="text-xs text-muted">{t(`events.audience.${audience}`)}</span>
  </div>

  <h3 class="mt-3 font-display text-xl font-semibold text-paper">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-paper-dim">{summary}</p>

  <dl class="mt-4 text-sm">
    <dt class="sr-only">{t('events.venue')}</dt>
    <dd class="text-muted">{venue}, {city}</dd>
  </dl>

  {
    ticketUrl && status === 'upcoming' && (
      <a
        href={ticketUrl}
        rel="noopener noreferrer"
        target="_blank"
        class="mt-5 inline-block rounded-lg bg-brass px-4 py-2 text-sm font-semibold text-ground transition-colors hover:bg-brass-bright"
      >
        {t('events.tickets')}
      </a>
    )
  }
</article>
