---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/ui.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import EventCard from '../components/EventCard.astro';
import { eventsByStatus } from '../lib/collections.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const { upcoming, past } = await eventsByStatus(locale);
---
<BaseLayout locale={locale} path="events" title={t('nav.events')} description={t('events.intro')}>
  <PageHeader eyebrow={t('site.name')} title={t('nav.events')} intro={t('events.intro')} />

  <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6">
    <h2 class="font-display text-2xl font-semibold text-paper">{t('events.upcoming')}</h2>
    {
      upcoming.length > 0 ? (
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          {upcoming.map((e) => (
            <EventCard
              locale={locale}
              title={e.entry.data.title}
              startDate={e.entry.data.startDate}
              endDate={e.entry.data.endDate}
              venue={e.entry.data.venue}
              city={e.entry.data.city}
              audience={e.entry.data.audience}
              summary={e.entry.data.summary}
              ticketUrl={e.entry.data.ticketUrl}
              status={e.status}
            />
          ))}
        </div>
      ) : (
        <p class="mt-6 text-sm text-muted">{t('events.empty')}</p>
      )
    }
  </section>

  {
    past.length > 0 && (
      <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6">
        <div class="rule mb-10"></div>
        <h2 class="font-display text-2xl font-semibold text-paper">{t('events.past')}</h2>
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
          {past.map((e) => (
            <EventCard
              locale={locale}
              title={e.entry.data.title}
              startDate={e.entry.data.startDate}
              endDate={e.entry.data.endDate}
              venue={e.entry.data.venue}
              city={e.entry.data.city}
              audience={e.entry.data.audience}
              summary={e.entry.data.summary}
              ticketUrl={e.entry.data.ticketUrl}
              status={e.status}
            />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
