---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/ui.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../config/site.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<BaseLayout locale={locale} path="about" title={t('nav.about')} description={t('about.intro')}>
  <PageHeader eyebrow={t('site.name')} title={t('nav.about')} intro={t('about.intro')} />

  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6">
    {/* TODO — supply the company story: founding, what the group does, team. */}
    <div class="prose">
      <p>{t('common.todo')}</p>
    </div>

    <div class="rule mt-14 mb-10"></div>

    <dl class="grid gap-6 text-sm sm:grid-cols-2">
      <div>
        <dt class="text-muted">{t('about.legalName')}</dt>
        <dd class="mt-1 text-paper">{SITE.legalName}</dd>
      </div>
      <div>
        <dt class="text-muted">{t('about.registration')}</dt>
        <dd class="mt-1 text-paper">{SITE.registrationNumber}</dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-muted">{t('about.address')}</dt>
        <dd class="mt-1 text-paper">{SITE.address}</dd>
      </div>
    </dl>
  </section>
</BaseLayout>
