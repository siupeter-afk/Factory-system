---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/ui.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import BrandAttribution from '../components/BrandAttribution.astro';
import IssueCard from '../components/IssueCard.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { brandsFor, issuesForBrand } from '../lib/collections.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);

const magazines = (await brandsFor(locale)).filter((b) => b.entry.data.kind === 'magazine');
const withIssues = await Promise.all(
  magazines.map(async (m) => ({ ...m, issues: await issuesForBrand(locale, m.slug) })),
);
---
<BaseLayout
  locale={locale}
  path="magazines"
  title={t('nav.magazines')}
  description={t('magazines.intro')}
>
  <PageHeader eyebrow={t('site.name')} title={t('nav.magazines')} intro={t('magazines.intro')} />

  {
    withIssues.map((m) => (
      <section class="mx-auto max-w-7xl px-4 pb-16 sm:px-6">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <div>
            <h2 class="font-display text-2xl font-semibold text-paper">{m.entry.data.title}</h2>
            <p class="mt-1.5 text-sm text-paper-dim">{m.entry.data.tagline}</p>
            <BrandAttribution
              locale={locale}
              ownership={m.entry.data.ownership}
              licensedTerritory={m.entry.data.licensedTerritory}
              class="mt-2"
            />
          </div>
          <a
            href={getRelativeLocaleUrl(locale, `brands/${m.slug}`)}
            class="text-sm font-medium text-brass hover:text-brass-bright"
          >
            {t('common.readMore')}
          </a>
        </div>

        {m.issues.length > 0 ? (
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {m.issues.map((i) => (
              <IssueCard
                locale={locale}
                title={i.entry.data.title}
                issueNumber={i.entry.data.issueNumber}
                publishedAt={i.entry.data.publishedAt}
                blurb={i.entry.data.blurb}
                cover={i.entry.data.cover}
                coverAlt={i.entry.data.coverAlt}
                readUrl={i.entry.data.readUrl}
              />
            ))}
          </div>
        ) : (
          <p class="mt-6 text-sm text-muted">{t('issues.empty')}</p>
        )}
        <div class="rule mt-14"></div>
      </section>
    ))
  }
</BaseLayout>
