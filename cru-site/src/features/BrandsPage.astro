---
import type { Locale } from '../i18n/config.ts';
import { useTranslations } from '../i18n/ui.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import BrandCard from '../components/BrandCard.astro';
import { brandsFor } from '../lib/collections.ts';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const brands = await brandsFor(locale);
---
<BaseLayout
  locale={locale}
  path="brands"
  title={t('brands.title')}
  description={t('brands.intro')}
>
  <PageHeader eyebrow={t('site.name')} title={t('brands.title')} intro={t('brands.intro')} />
  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        brands.map((b) => (
          <BrandCard
            locale={locale}
            slug={b.slug}
            title={b.entry.data.title}
            kind={b.entry.data.kind}
            tagline={b.entry.data.tagline}
            ownership={b.entry.data.ownership}
            licensedTerritory={b.entry.data.licensedTerritory}
            logo={b.entry.data.logo}
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
